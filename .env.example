# Serve every screen from the in-browser MSW mocks, with no services running.
NEXT_PUBLIC_API_MOCKS=true

# Upstream services, used only on the server by the BFF.
TASK_SERVICE_URL=http://localhost:8080
JOB_SERVICE_URL=http://localhost:8081

# Test JWT, used in development when there is no session cookie. local-env/env.sh writes it.
DEV_JWT=

# Dev session (development builds only). Must match the JWT_SECRET of both services.
JWT_SECRET=
DEV_TENANT_ID=
